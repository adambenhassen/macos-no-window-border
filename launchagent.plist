<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.macos-no-window-border</string>
	<key>ProgramArguments</key>
	<array>
		<string>@ROOT@/noborder.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/macos-no-window-border.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/macos-no-window-border.log</string>
</dict>
</plist>
